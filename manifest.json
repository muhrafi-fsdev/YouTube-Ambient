{
  "manifest_version": 3,
  "name": "YouTube Ambient Glass",
  "version": "1.9.0",
  "description": "Perpanjangan gambar di sekitar video YouTube. Dikembangkan oleh Akira Keiji.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "YouTube Ambient Glass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["player.css"],
      "js": ["settings.js", "bars.js", "ambient.js", "edges.js", "player.js"],
      "run_at": "document_idle"
    }
  ]
}
